<?xml version="1.0"?>
<!--
  arm6dof.urdf  -  Generic 6-DOF robotic arm (placeholder for the Digital Twin project)

  Purpose:
    A self-contained 6-revolute-joint arm + 2-finger gripper, built ONLY from
    primitive shapes (no external mesh files), so it loads instantly in PyBullet,
    Isaac Sim, RViz, etc. on any machine.

  Kinematics (home pose = all joints 0 -> arm points straight up +Z):
    joint_1  base   yaw    (axis Z)  - shoulder pan
    joint_2  shoulder pitch (axis Y) - shoulder lift
    joint_3  elbow   pitch (axis Y)
    joint_4  wrist   roll  (axis Z)
    joint_5  wrist   pitch (axis Y)
    joint_6  flange  roll  (axis Z)
    + finger_joint_left / finger_joint_right (prismatic) for the gripper
    + fixed frame "tcp" = the end-effector reference point used for accuracy tests

  When your real arm arrives, replace this file with the manufacturer's URDF
  (keep the link/joint NAMES the same where possible so downstream code is unchanged).
-->
<robot name="arm6dof">

  <!-- ============ materials (colours) ============ -->
  <material name="grey">   <color rgba="0.4 0.4 0.45 1"/></material>
  <material name="blue">   <color rgba="0.15 0.45 0.85 1"/></material>
  <material name="orange"> <color rgba="0.95 0.55 0.15 1"/></material>
  <material name="dark">   <color rgba="0.15 0.15 0.18 1"/></material>

  <!-- ============ base ============ -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.06" length="0.10"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.06" length="0.10"/></geometry>
    </collision>
  </link>

  <!-- ============ joint 1 : shoulder pan (Z) ============ -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child  link="link_1"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="30" velocity="2.0"/>
  </joint>
  <link name="link_1">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="1.5"/>
      <inertia ixx="0.005" iyy="0.005" izz="0.005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.05" length="0.10"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.05" length="0.10"/></geometry>
    </collision>
  </link>

  <!-- ============ joint 2 : shoulder lift (Y) ============ -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child  link="link_2"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="30" velocity="2.0"/>
  </joint>
  <link name="link_2">
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="1.2"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.004" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry><cylinder radius="0.045" length="0.30"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry><cylinder radius="0.045" length="0.30"/></geometry>
    </collision>
  </link>

  <!-- ============ joint 3 : elbow (Y) ============ -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child  link="link_3"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6180" upper="2.6180" effort="20" velocity="2.5"/>
  </joint>
  <link name="link_3">
    <inertial>
      <origin xyz="0 0 0.125"/>
      <mass value="1.0"/>
      <inertia ixx="0.012" iyy="0.012" izz="0.003" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.125"/>
      <geometry><cylinder radius="0.04" length="0.25"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.125"/>
      <geometry><cylinder radius="0.04" length="0.25"/></geometry>
    </collision>
  </link>

  <!-- ============ joint 4 : wrist roll (Z) ============ -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child  link="link_4"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="3.0"/>
  </joint>
  <link name="link_4">
    <inertial>
      <origin xyz="0 0 0.025"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.035" length="0.05"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.035" length="0.05"/></geometry>
    </collision>
  </link>

  <!-- ============ joint 5 : wrist pitch (Y) ============ -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child  link="link_5"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="10" velocity="3.0"/>
  </joint>
  <link name="link_5">
    <inertial>
      <origin xyz="0 0 0.02"/>
      <mass value="0.4"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
    </collision>
  </link>

  <!-- ============ joint 6 : flange roll (Z) ============ -->
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child  link="link_6"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="3.0"/>
  </joint>
  <link name="link_6">
    <inertial>
      <origin xyz="0 0 0.015"/>
      <mass value="0.3"/>
      <inertia ixx="0.0005" iyy="0.0005" izz="0.0005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.015"/>
      <geometry><cylinder radius="0.04" length="0.03"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015"/>
      <geometry><cylinder radius="0.04" length="0.03"/></geometry>
    </collision>
  </link>

  <!-- ============ gripper base (fixed to flange) ============ -->
  <joint name="gripper_mount" type="fixed">
    <parent link="link_6"/>
    <child  link="gripper_base"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>
  <link name="gripper_base">
    <inertial>
      <origin xyz="0 0 0.02"/>
      <mass value="0.2"/>
      <inertia ixx="0.0003" iyy="0.0003" izz="0.0003" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.08 0.04 0.04"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.08 0.04 0.04"/></geometry>
    </collision>
  </link>

  <!-- ============ left finger (prismatic along +X) ============ -->
  <joint name="finger_joint_left" type="prismatic">
    <parent link="gripper_base"/>
    <child  link="finger_left"/>
    <origin xyz="0.02 0 0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.03" effort="5" velocity="0.1"/>
  </joint>
  <link name="finger_left">
    <inertial>
      <origin xyz="0 0 0.02"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.01 0.02 0.05"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.01 0.02 0.05"/></geometry>
    </collision>
  </link>

  <!-- ============ right finger (prismatic along -X) ============ -->
  <joint name="finger_joint_right" type="prismatic">
    <parent link="gripper_base"/>
    <child  link="finger_right"/>
    <origin xyz="-0.02 0 0.05" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0.0" upper="0.03" effort="5" velocity="0.1"/>
  </joint>
  <link name="finger_right">
    <inertial>
      <origin xyz="0 0 0.02"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.01 0.02 0.05"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.01 0.02 0.05"/></geometry>
    </collision>
  </link>

  <!-- ============ TCP: end-effector reference frame (no geometry) ============ -->
  <!-- This is the point whose pose we compare against the commanded pose        -->
  <!-- for the "position accuracy < 1 cm" success metric.                         -->
  <joint name="tcp_fixed" type="fixed">
    <parent link="gripper_base"/>
    <child  link="tcp"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>
  <link name="tcp">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

</robot>
